# ──────────────────────────────────────────────────────
#  Phosnap 환경 변수 템플릿
#  이 파일을 복사해서 .env.local 로 저장하고 값을 채워주세요.
#  .env.local 은 .gitignore에 포함되어 있어 Git에 올라가지 않습니다.
# ──────────────────────────────────────────────────────

# ── Waitlist 폼 백엔드 (Formspree) ──
# 1. https://formspree.io 무료 계정 생성
# 2. "New Form" 생성 → Form ID 복사 (예: xldgjrwq)
# 3. 아래에 붙여넣기
VITE_FORMSPREE_ID=your_formspree_form_id

# ── Contact 폼 백엔드 (Formspree) ──
VITE_FORMSPREE_CONTACT_ID=your_contact_form_id

# ── TossPayments 결제 연동 ──
# 1. https://developers.tosspayments.com 에서 회원가입
# 2. 대시보드 → API 키 → 클라이언트 키 복사
# 3. 테스트 키: test_ck_ 로 시작 / 라이브 키: live_ck_ 로 시작
# ※ 라이브 키는 사업자등록증 인증 후 발급됩니다
VITE_TOSS_CLIENT_KEY=test_ck_your_toss_client_key

# ── Supabase 인증 + DB ──
# 1. https://supabase.com 가입 → New Project (이름: phosnap)
# 2. Settings → API → Project URL + anon/public key 복사
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
